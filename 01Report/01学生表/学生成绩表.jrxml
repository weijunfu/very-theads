	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="FuPdf"/>
	<parameter name="idStudent" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select
    c.name course_name,
    t.name teacher_name,
    cs.score
from course_score cs
         join course c on c.id = cs.id_course
         join teacher t on t.id = c.id_teacher
where cs.id_student = $P{idStudent}]]>
	</queryString>
