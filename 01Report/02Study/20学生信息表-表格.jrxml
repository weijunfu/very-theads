	<subDataset name="DS_StudentScore" uuid="8e974398-7cb9-45b8-9158-1e491992036a">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="FuPdf"/>
		<queryString language="SQL">
			<![CDATA[select
    s.name as student_name,
    c.name as course_name,
    cs.score
from student s
join course_score cs on cs.id_student = s.id
join course c on c.id = cs.id_course]]>
		</queryString>
		<field name="student_name" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="name"/>
